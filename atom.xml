    <author>
      <name>Nathan Gao</name>
    </author>
    <category term="读书与思考" scheme="https://www.zebin-yue.top/categories/reading-reflection/"/>
    <category term="语言学" scheme="https://www.zebin-yue.top/tags/%E8%AF%AD%E8%A8%80%E5%AD%A6/"/>
